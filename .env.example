# Template only - copy to .env (project root) and fill in real values.
# Docker Compose auto-reads this file; Spring Boot needs these exported as
# environment variables (IDE run config, shell, or deployment secrets).
# NEVER commit .env.

# --- Docker Compose (compose.yaml) ---
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=

# --- Spring Boot backend (qa / prod profiles) ---
MYSQL_USER=root
MYSQL_PASSWORD=
POSTGRES_USER=copmap_app
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ISSUER=api.substring.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONT_END_URL=http://localhost:5173
